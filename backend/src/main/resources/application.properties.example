spring.application.name=government-subsidy-system
server.port=8084

# Database Configuration (MySQL 8.x)
spring.datasource.url=jdbc:mysql://localhost:3306/subsidy_db
spring.datasource.username=your_database_username
spring.datasource.password=your_database_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.sql.init.mode=never

# HikariCP Connection Pool

spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.connection-timeout=10000

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Security Configuration
app.jwt.secret=replace_with_a_secure_jwt_secret
app.jwt.expiration-ms=86400000

# File Upload Configuration
app.upload.dir=uploads/documents
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Scheduler
app.scheduling.enabled=true

# Logging
logging.level.root=INFO
logging.level.com.example.governmentsubsidy=INFO
logging.level.org.springframework.security=WARN
